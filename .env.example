# URL del proyecto Supabase. Ejemplo: https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable key) de Supabase Auth. Empieza por sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app para enlaces de correo y callbacks de auth.
# En desarrollo, si se deja vacía, la app usa http://localhost:3000.
# En producción es obligatoria. Ejemplo: https://TU-SITIO.netlify.app
NEXT_PUBLIC_SITE_URL=
